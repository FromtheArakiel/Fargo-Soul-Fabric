{
  "schemaVersion": 1,
  "icon": "assets/fargosoulfabric/icon.png",
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "FromtheArakiel"
  ],
  "contributors": [
    "First-Sight (Oringin Author)"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.arakiel.fargosoulfabric.FSF"
    ],
    "client": [
      "dev.arakiel.fargosoulfabric.client.FSFClient"
    ]
  },
  "mixins": [
    "fargosoulfabric.mixins.json",
    {
      "config": "fargosoulfabric.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "fargosoulfabric.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "curiosfabric": ">=9.5.1",
    "geckolib": ">=4.9.3"
  }
}
